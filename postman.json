{
  "info": {
    "name": "Library Books API - Project 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "bookId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "List books",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books",
        "header": [
          {
            "key": "x-request-id",
            "value": "{{$guid}}"
          }
        ]
      }
    },
    {
      "name": "Create book",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/books",
        "header": [
          {
            "key": "x-request-id",
            "value": "{{$guid}}"
          },
          {
            "key": "x-role",
            "value": "librarian"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"  the hobbit  \",\n  \"genre\": \"fiction\",\n  \"publishedYear\": 1937\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('bookId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get book",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books/{{bookId}}",
        "header": [
          {
            "key": "x-request-id",
            "value": "{{$guid}}"
          }
        ]
      }
    },
    {
      "name": "Update book",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/books/{{bookId}}",
        "header": [
          {
            "key": "x-request-id",
            "value": "{{$guid}}"
          },
          {
            "key": "x-role",
            "value": "librarian"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"publishedYear\": 1938\n}"
        }
      }
    },
    {
      "name": "Duplicate book (409)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/books",
        "header": [
          {
            "key": "x-request-id",
            "value": "{{$guid}}"
          },
          {
            "key": "x-role",
            "value": "librarian"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"THE HOBBIT\",\n  \"genre\": \"fiction\",\n  \"publishedYear\": 1937\n}"
        }
      }
    },
    {
      "name": "Invalid year (400)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/books",
        "header": [
          {
            "key": "x-request-id",
            "value": "{{$guid}}"
          },
          {
            "key": "x-role",
            "value": "librarian"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Bad Year\",\n  \"genre\": \"science\",\n  \"publishedYear\": 1449\n}"
        }
      }
    },
    {
      "name": "Missing role (403)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/books",
        "header": [
          {
            "key": "x-request-id",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"No Role\",\n  \"genre\": \"history\",\n  \"publishedYear\": 2000\n}"
        }
      }
    },
    {
      "name": "Delete book",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/books/{{bookId}}",
        "header": [
          {
            "key": "x-request-id",
            "value": "{{$guid}}"
          },
          {
            "key": "x-role",
            "value": "librarian"
          }
        ]
      }
    }
  ]
}
